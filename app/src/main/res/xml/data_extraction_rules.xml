<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="./exoplayer" />
        <exclude domain="file" path="./download" />
        <exclude domain="database" path="exoplayer_internal.db" />
        <!-- Listening history stays on this device; exclude its database from cloud backup. -->
        <exclude domain="database" path="song.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="./exoplayer" />
        <exclude domain="file" path="./download" />
        <exclude domain="database" path="exoplayer_internal.db" />
        <!-- Keep the local listening-history database off device-to-device transfers. -->
        <exclude domain="database" path="song.db" />
    </device-transfer>
</data-extraction-rules>
