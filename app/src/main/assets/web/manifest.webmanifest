{
  "name": "Soundwave Web",
  "short_name": "Soundwave",
  "description": "A browser build of the Soundwave music player. Local-first, no account, no cloud AI.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
